  ]
};

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "Conveyor Belt Materials and Types: Selection Guide",
  "description": "Conveyor belt materials and types compared: PVC, polyurethane, silicone, rubber, modular plastic, and metal. Food-contact compliance, heat, abrasion, and cost.",
  "url": "https://packagingconveyor.com/resources/conveyor-belting/",
  "datePublished": "2026-03-12",
  "publisher": { "@type": "Organization", "name": "PackagingConveyor.com", "url": "https://packagingconveyor.com" }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What are the main types of conveyor belt material?",
      "acceptedAnswer": { "@type": "Answer", "text": "Packaging and food conveyors use six main belt materials: (1) PVC, general-purpose and lowest cost for dry applications. (2) Polyurethane (PU), the common food-grade choice with good abrasion and cut resistance. (3) Silicone, for high heat and non-stick release in bakery lines. (4) Rubber, for heavy-duty, high-grip incline and impact service. (5) Modular plastic, interlocking modules that are sprocket-driven and repairable. (6) Metal (wire mesh, flat wire, solid steel), for ovens, freezers, and heavy loads. Selection depends on product contact, temperature, chemicals, incline, uptime needs, and budget." }
    },
    {
      "@type": "Question",
      "name": "What belt material is FDA-approved for food contact?",
      "acceptedAnswer": { "@type": "Answer", "text": "Polyurethane, silicone, some PVC formulations, acetal and polypropylene modular plastic, and stainless steel are available in formulations that comply with FDA 21 CFR Part 177 for food contact. Polyurethane is widely specified because it combines food-contact compliance, abrasion resistance, and easy cleaning. USDA acceptance for meat and poultry also depends on belt construction: smooth, cleanable surfaces with no harborage points." }
    },
    {
      "@type": "Question",
      "name": "Which conveyor belt material is most abrasion resistant?",
      "acceptedAnswer": { "@type": "Answer", "text": "Among polymer belts, rubber and polyurethane offer the highest abrasion resistance. In modular plastic belts, resin choice matters: acetal is hard and wear resistant, abrasion-resistant nylon grades are offered for severe wear, and polypropylene trades some wear resistance for chemical resistance. Metal belts resist abrasion best but cost more. Ask suppliers for wear data on your product." }
    },
    {
      "@type": "Question",
      "name": "How long does a conveyor belt last?",
      "acceptedAnswer": { "@type": "Answer", "text": "Belt life depends on material, product abrasion, speed, tension, cleaning chemicals, temperature, and maintenance quality. Modular plastic belts often last longest in service because damaged modules are replaced individually instead of replacing the whole belt. Tracking, tensioning, and cleaning have more effect on belt life than material alone, and a mistracking belt can be destroyed quickly." }
    },
    {
      "@type": "Question",
      "name": "What is a modular conveyor belt?",
      "acceptedAnswer": { "@type": "Answer", "text": "A modular conveyor belt consists of interlocking injection-molded plastic modules joined by hinge rods. Damaged modules can be replaced without removing the entire belt. Modular belts are sprocket-driven, so they do not mistrack, and they are available in food-grade acetal, polypropylene, and polyethylene. They cost more upfront than flat belts but reduce repair time and downtime." }
    }
  ]
};
---

<BaseLayout title="Conveyor Belt Materials and Types: Selection Guide" description="Conveyor belt materials and types compared: PVC, polyurethane, silicone, rubber, modular plastic, and metal, with FDA food contact, heat, abrasion, and cost." canonical="https://packagingconveyor.com/resources/conveyor-belting/" schema={[breadcrumbSchema, articleSchema, faqSchema]}>

  <!-- HERO -->
  <section class="bg-blueprint relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20 relative z-10">
      <nav class="text-sm font-mono text-white/60 mb-8" aria-label="Breadcrumb">
        <a href="/" class="hover:text-white/70">Home</a>
        <span class="mx-2">/</span>
        <a href="/resources/" class="hover:text-white/70">Resources</a>
        <span class="mx-2">/</span>
        <span class="text-white/70">Conveyor Belting</span>
      </nav>
      <div class="max-w-3xl">
        <div class="section-label text-accent-bright/80 mb-6">Resource Guide</div>
        <h1 class="font-display text-5xl sm:text-6xl lg:text-7xl font-extrabold text-white tracking-wide uppercase leading-[0.95] mb-8">
          Conveyor Belt <span class="text-accent-bright">Materials</span> &#x26; Types
        </h1>
      </div>
    </div>
  </section>

  <!-- AIO DEFINITION -->
  <article>
    <section class="py-12 bg-surface-dim" aria-labelledby="aio-heading">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <p id="aio-heading" class="text-lg text-ink leading-relaxed">
          Conveyor belt material determines product grip, temperature tolerance, chemical and abrasion resistance, food-contact compliance, and belt life. Packaging and food lines use six main types: PVC (general-purpose), polyurethane (food-grade workhorse), silicone (high heat, non-stick), rubber (heavy-duty grip and impact), modular plastic (interlocking, repairable), and metal (ovens, freezers, heavy loads). Start with the comparison table, then work through the six selection questions below it.
        </p>
      </div>
    </section>

    <!-- COMPARISON TABLE -->
    <section class="py-20 bg-surface" aria-labelledby="compare-heading">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="section-label text-accent mb-4">Comparison</div>
        <h2 id="compare-heading" class="font-display text-4xl sm:text-5xl font-extrabold text-ink tracking-wide uppercase mb-10">
          Belt Material <span class="text-accent">Comparison</span>
        </h2>

        <div class="overflow-x-auto -mx-4 px-4">
          <table class="w-full text-left border-collapse min-w-[950px]">
            <thead>
              <tr class="border-b-2 border-ink">
                <th class="font-display text-base font-bold uppercase tracking-wider text-ink py-4 pr-4">Material</th>
                <th class="font-display text-base font-bold uppercase tracking-wider text-ink py-4 pr-4">Heat &#x26; Cold</th>
                <th class="font-display text-base font-bold uppercase tracking-wider text-ink py-4 pr-4">Food Contact</th>
                <th class="font-display text-base font-bold uppercase tracking-wider text-ink py-4 pr-4">Abrasion Resistance</th>
                <th class="font-display text-base font-bold uppercase tracking-wider text-ink py-4 pr-4">Relative Cost</th>
                <th class="font-display text-base font-bold uppercase tracking-wider text-ink py-4">Best For</th>
              </tr>
            </thead>
            <tbody class="text-base text-ink-muted">
              <tr class="border-b border-border">
                <td class="py-4 pr-4 font-semibold text-ink">PVC</td>
                <td class="py-4 pr-4">Ambient. Stiffens in cold, softens in heat</td>
                <td class="py-4 pr-4">Limited formulations</td>
                <td class="py-4 pr-4">Moderate</td>
                <td class="py-4 pr-4 font-mono text-sm">$</td>
                <td class="py-4">Dry, packaged goods, distribution</td>
              </tr>
              <tr class="border-b border-border">
                <td class="py-4 pr-4 font-semibold text-ink">Polyurethane</td>
                <td class="py-4 pr-4">Freezer to hot washdown</td>
                <td class="py-4 pr-4">Yes</td>
                <td class="py-4 pr-4">High</td>
                <td class="py-4 pr-4 font-mono text-sm">$$</td>
                <td class="py-4">Food packaging, sanitary</td>
              </tr>
              <tr class="border-b border-border">
                <td class="py-4 pr-4 font-semibold text-ink">Silicone</td>
                <td class="py-4 pr-4">Highest heat of the elastomers</td>
                <td class="py-4 pr-4">Yes</td>
                <td class="py-4 pr-4">Low</td>
                <td class="py-4 pr-4 font-mono text-sm">$$$</td>
                <td class="py-4">Bakery, oven discharge, sticky</td>
              </tr>
              <tr class="border-b border-border">
                <td class="py-4 pr-4 font-semibold text-ink">Rubber</td>
                <td class="py-4 pr-4">Varies by compound</td>
                <td class="py-4 pr-4">Specialty compounds only</td>
                <td class="py-4 pr-4">Very high</td>
                <td class="py-4 pr-4 font-mono text-sm">$$</td>
                <td class="py-4">Heavy-duty, incline, impact</td>
              </tr>
              <tr class="border-b border-border">
                <td class="py-4 pr-4 font-semibold text-ink">Modular plastic</td>
                <td class="py-4 pr-4">Freezer to hot, varies by resin</td>
                <td class="py-4 pr-4">Yes (acetal, PP, PE)</td>
                <td class="py-4 pr-4">High, varies by resin</td>
                <td class="py-4 pr-4 font-mono text-sm">$$-$$$</td>
                <td class="py-4">Food processing, curves, repairability</td>
              </tr>
              <tr>
                <td class="py-4 pr-4 font-semibold text-ink">Metal</td>
                <td class="py-4 pr-4">Oven heat to deep freeze</td>
                <td class="py-4 pr-4">Yes (stainless)</td>
                <td class="py-4 pr-4">Very high</td>
                <td class="py-4 pr-4 font-mono text-sm">$$$-$$$$</td>
                <td class="py-4">Ovens, freezers, heavy loads</td>
              </tr>
            </tbody>
          </table>
        </div>
        <p class="text-sm text-ink-muted mt-4">Cost per linear foot: $ = lowest, $$$$ = highest. Ratings vary by formulation and supplier, so confirm temperature range, food-contact compliance, and chemical resistance on the belt datasheet. See the <a href="/resources/conveyor-cost-guide/" class="text-accent hover:text-accent-hover font-semibold">conveyor cost guide</a> for cost factors.</p>
      </div>
    </section>

    <!-- SELECTION GUIDE -->
    <section class="py-20 bg-surface-dim" aria-labelledby="selection-heading">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="section-label text-accent mb-4">Selection Guide</div>
        <h2 id="selection-heading" class="font-display text-4xl sm:text-5xl font-extrabold text-ink tracking-wide uppercase mb-8">
          How to Choose <span class="text-accent">a Conveyor Belt</span>
        </h2>
        <div class="text-lg text-ink-muted leading-relaxed space-y-5">
          <p>Answer these questions in order. Each one narrows the list.</p>
          <ol class="list-decimal list-inside space-y-4 ml-2">
            <li><strong class="text-ink">Does exposed product touch the belt?</strong> If the product is unpackaged food or pharmaceutical, the belt must be food-contact compliant (PU, silicone, food-grade modular, stainless metal, or a compliant PVC). Sealed cases and wrapped goods can run on any material.</li>
            <li><strong class="text-ink">What is the operating temperature?</strong> Ambient: PVC, PU, modular. Freezer: PU, suitable modular resins, metal. Hot product: silicone or metal. Oven zones: metal.</li>
            <li><strong class="text-ink">What chemicals and wear does the belt face?</strong> Sanitizers (chlorine, quaternary ammonium, peracetic acid) degrade PVC faster than PU. Oils and fats need oil-resistant formulations. Abrasive products (sugar, salt, grit, sharp-edged parts) favor rubber, PU, or wear-resistant modular resins.</li>
            <li><strong class="text-ink">Is the conveyor flat or inclined?</strong> Moderate inclines need textured tops (rough-top, nub-top, friction-top). Steep inclines need <a href="/conveyor-types/cleated-conveyors/" class="text-accent hover:text-accent-hover font-semibold">cleats or flights</a>.</li>
            <li><strong class="text-ink">How critical is uptime?</strong> Modular belts (quick module replacement) and positive-drive belts (no tracking adjustment) suit high-uptime lines. Lines that tolerate occasional belt changes can use lower-cost flat belts.</li>
            <li><strong class="text-ink">What is the budget priority?</strong> Lowest upfront cost: PVC. Lowest repair cost on high-wear lines: modular plastic. Best general food-grade value: PU.</li>
          </ol>
        </div>
      </div>
    </section>

    <!-- PVC -->
    <section class="py-20 bg-surface" aria-labelledby="pvc-heading">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="section-label text-accent mb-4">Belt Material</div>
        <h2 id="pvc-heading" class="font-display text-4xl sm:text-5xl font-extrabold text-ink tracking-wide uppercase mb-8">
          PVC <span class="text-accent">Belts</span>
        </h2>
        <div class="text-lg text-ink-muted leading-relaxed space-y-5">
          <p>
            PVC (polyvinyl chloride) belts are the lowest-cost option for dry, room-temperature applications: cartons, cases, bags, and packaged goods in distribution, fulfillment, and non-food packaging. Most standard PVC formulations are not intended for direct food contact, which limits their use in <a href="/industries/food-conveyors/" class="text-accent hover:text-accent-hover font-semibold">food packaging</a> to already-packaged product.
          </p>
          <p>
            PVC resists oils, greases, and mild solvents and comes in smooth, rough-top, and fabric-textured surfaces. Rough-top PVC adds grip for inclines. PVC stiffens in the cold and softens with heat, so it is a poor fit for freezer or oven service. Construction is one or more plies of polyester or cotton fabric for tensile strength, with a PVC coating that forms the carrying surface.
          </p>
        </div>
      </div>
    </section>

    <!-- POLYURETHANE -->
    <section class="py-20 bg-surface-dim" aria-labelledby="pu-heading">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="section-label text-accent mb-4">Belt Material</div>
        <h2 id="pu-heading" class="font-display text-4xl sm:text-5xl font-extrabold text-ink tracking-wide uppercase mb-8">
          Polyurethane <span class="text-accent">(PU) Belts</span>
        </h2>
        <div class="text-lg text-ink-muted leading-relaxed space-y-5">
          <p>
            Polyurethane is the standard belt material for food-grade packaging conveyors. PU formulations that comply with <a href="https://www.ecfr.gov/current/title-21/chapter-I/subchapter-B/part-177" target="_blank" rel="noopener noreferrer" class="text-accent hover:text-accent-hover font-semibold">FDA 21 CFR Part 177</a> allow direct contact with meat, dairy, baked goods, confectionery, and produce. PU resists abrasion, cutting, food acids, fats, and cleaning agents better than PVC, which makes it the default for <a href="/industries/food-conveyors/sanitary/" class="text-accent hover:text-accent-hover font-semibold">sanitary conveyor</a> applications. PU also stays flexible at freezer temperatures where PVC turns stiff.
          </p>
          <p>
            Food-grade PU belts usually come in white or blue for visual contamination detection: a blue fragment stands out in white product, and a white belt shows dark contaminants. Some PU and modular belts are also made in metal-detectable formulations so <a href="/conveyor-functions/inspection-detection/" class="text-accent hover:text-accent-hover font-semibold">metal detection systems</a> can catch belt fragments.
          </p>
          <p>
            PU surfaces include smooth, textured (diamond, nub, or waffle patterns for grip), and positive-drive. Positive-drive PU belts have teeth or lugs on the underside that engage sprockets, which eliminates slip and tracking adjustment while keeping a smooth, cleanable top surface.
          </p>
        </div>
      </div>
    </section>

    <!-- SILICONE -->
    <section class="py-20 bg-surface" aria-labelledby="silicone-heading">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="section-label text-accent mb-4">Belt Material</div>
        <h2 id="silicone-heading" class="font-display text-4xl sm:text-5xl font-extrabold text-ink tracking-wide uppercase mb-8">
          Silicone <span class="text-accent">Belts</span>
        </h2>
        <div class="text-lg text-ink-muted leading-relaxed space-y-5">
          <p>
            Silicone handles the highest temperatures of any elastomer belt material and is available in food-contact grades. It serves bakery oven discharge, <a href="/industries/food-conveyors/cooling/" class="text-accent hover:text-accent-hover font-semibold">cooling conveyors</a>, and transfers of hot bread, cookies, crackers, and pastries.
          </p>
          <p>
            Silicone releases sticky products (dough, candy, cheese) cleanly, which reduces buildup and simplifies cleaning. It is less durable than PU: it cuts and abrades more easily and costs more. Use silicone only when the application needs high heat tolerance, non-stick release, or both. For sticky products at moderate temperatures, PU with a release coating or PTFE top coat is a lower-cost alternative. For non-food high-heat service, metal belts last longer.
          </p>
        </div>
      </div>
    </section>

    <!-- RUBBER -->
    <section class="py-20 bg-surface-dim" aria-labelledby="rubber-heading">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="section-label text-accent mb-4">Belt Material</div>
        <h2 id="rubber-heading" class="font-display text-4xl sm:text-5xl font-extrabold text-ink tracking-wide uppercase mb-8">
          Rubber <span class="text-accent">Belts</span>
        </h2>
        <div class="text-lg text-ink-muted leading-relaxed space-y-5">
          <p>
            Rubber belts provide the highest grip, abrasion resistance, and impact absorption of the polymer belts. Natural and synthetic compounds (SBR, nitrile, neoprene, EPDM) suit different environments. Rubber dominates heavy bulk handling, and in packaging it appears on <a href="/conveyor-types/incline-conveyors/" class="text-accent hover:text-accent-hover font-semibold">incline conveyors</a> carrying heavy cases, bags, and raw materials, and at load points where product drops onto the belt.
          </p>
          <p>
            Most rubber compounds are not intended for direct food contact. Specialty white nitrile and other food-grade compounds are formulated to FDA requirements such as <a href="https://www.ecfr.gov/current/title-21/chapter-I/subchapter-B/part-177/subpart-C/section-177.2600" target="_blank" rel="noopener noreferrer" class="text-accent hover:text-accent-hover font-semibold">21 CFR 177.2600</a> for rubber articles in repeated food contact. Otherwise, textured PU belts are the usual food-grade substitute for rubber's grip.
          </p>
        </div>
      </div>
    </section>

    <!-- MODULAR PLASTIC -->
    <section class="py-20 bg-surface" aria-labelledby="modular-heading">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="section-label text-accent mb-4">Belt Material</div>
        <h2 id="modular-heading" class="font-display text-4xl sm:text-5xl font-extrabold text-ink tracking-wide uppercase mb-8">
          Modular Plastic <span class="text-accent">Belts</span>
        </h2>
        <div class="text-lg text-ink-muted leading-relaxed space-y-5">
          <p>
            Modular plastic belts are interlocking injection-molded modules joined by hinge rods. A damaged section is replaced module by module without removing the belt, which makes <a href="/conveyor-types/modular-conveyors/" class="text-accent hover:text-accent-hover font-semibold">modular belt conveyors</a> the lowest-maintenance option on lines where sharp products, heavy loads, or process equipment damage belts often.
          </p>
          <p>
            Resin choice sets performance. Acetal (POM) is hard, strong, and wear resistant with low friction. Polypropylene resists chemicals and costs less. Polyethylene holds up to impact and low temperatures. Abrasion-resistant nylon grades are offered for severe wear. Food-grade formulations are standard. Surfaces include flat, raised-rib, perforated (for drainage, airflow, and vacuum), friction-top, and nub-top.
          </p>
          <p>
            Sprockets drive the belt through its hinge rods or module features, so the belt cannot mistrack and holds position for <a href="/conveyor-functions/indexing-conveyors/" class="text-accent hover:text-accent-hover font-semibold">indexing applications</a>. Radius-capable modules articulate through curves, spirals, and serpentine <a href="/conveyor-functions/storage-conveyors/" class="text-accent hover:text-accent-hover font-semibold">storage conveyors</a>. The main downside is upfront cost, which is higher than PVC or PU flat belts and is offset by lower repair labor and less downtime on high-wear, long-shift lines.
          </p>
        </div>
      </div>
    </section>

    <!-- METAL BELTS -->
    <section class="py-20 bg-surface-dim" aria-labelledby="metal-heading">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="section-label text-accent mb-4">Belt Material</div>
        <h2 id="metal-heading" class="font-display text-4xl sm:text-5xl font-extrabold text-ink tracking-wide uppercase mb-8">
          Metal <span class="text-accent">Belts</span>
        </h2>
        <div class="text-lg text-ink-muted leading-relaxed space-y-5">
          <p>
            Metal belts handle the most extreme conditions: oven and furnace heat, deep freezing, heavy loads, corrosive chemicals, and abrasive products. Three constructions serve packaging-adjacent lines:
          </p>
          <ul class="list-disc list-inside space-y-3 ml-2">
            <li><strong class="text-ink">Wire mesh:</strong> woven or welded wire in an open grid for airflow, drainage, and heat transfer. Standard for baking ovens, cooling tunnels, and freezers. Type 304 or 316 stainless is used for food. See <a href="/conveyor-types/wire-mesh-conveyors/" class="text-accent hover:text-accent-hover font-semibold">wire mesh conveyors</a>.</li>
            <li><strong class="text-ink">Flat wire:</strong> flat strip formed into a flatter, more open carrying surface than woven mesh, joined by cross rods. Used for delicate products where mesh marks are unacceptable.</li>
            <li><strong class="text-ink">Solid steel belt:</strong> a continuous stainless strip. The flattest, most hygienic metal belt, used for chocolate, candy, and drying applications. Highest relative cost.</li>
          </ul>
          <p>
            Metal belts need different drives than polymer belts: sprockets for mesh and flat wire, and drums over stainless slide beds for solid steel. Food applications use H1-registered food-grade lubricants on belt edges and drive components.
          </p>
        </div>
      </div>
    </section>

    <!-- BELT MAINTENANCE PREVIEW -->
    <section class="py-20 bg-surface" aria-labelledby="maintain-heading">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="section-label text-accent mb-4">Maintenance</div>
        <h2 id="maintain-heading" class="font-display text-4xl sm:text-5xl font-extrabold text-ink tracking-wide uppercase mb-8">
          Belt <span class="text-accent">Maintenance Essentials</span>
        </h2>
        <div class="text-lg text-ink-muted leading-relaxed space-y-5">
          <p>
            Maintenance quality affects belt life as much as material choice. Three tasks decide whether a belt reaches its expected life:
          </p>
          <ul class="list-disc list-inside space-y-3 ml-2">
            <li><strong class="text-ink">Tracking:</strong> a mistracking belt rides against the frame, grinding and fraying the edge until it fails. Check tracking on a set schedule, and more often on high-speed lines.</li>
            <li><strong class="text-ink">Tensioning:</strong> over-tension overloads bearings and stretches the belt permanently. Under-tension lets the belt slip on the drive pulley, generating heat and glazing the underside. Follow the belt maker's tension specification.</li>
            <li><strong class="text-ink">Cleaning:</strong> buildup on the top and underside causes tracking problems, bacterial growth, and delamination. Use cleaning chemicals the belt material is rated for.</li>
          </ul>
          <p>
            For schedules and troubleshooting, see the <a href="/resources/conveyor-maintenance/" class="text-accent hover:text-accent-hover font-semibold">conveyor maintenance and troubleshooting guide</a>.
          </p>
        </div>
      </div>
    </section>

    <!-- RELATED -->
    <section class="py-20 bg-ink-light" aria-labelledby="related-heading">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="section-label text-accent-bright mb-4">Related</div>
        <h2 id="related-heading" class="font-display text-4xl sm:text-5xl font-extrabold text-white tracking-wide uppercase mb-10">
          Related <span class="text-accent-bright">Guides</span>
        </h2>
        <div class="grid sm:grid-cols-3 gap-5">
          <a href="/conveyor-types/flat-belt-conveyors/" class="group p-7 border border-white/10 bg-white/[0.03] hover:bg-white/[0.06] hover:border-accent/40 transition-all">
            <h3 class="font-display text-xl font-bold uppercase tracking-wider text-white group-hover:text-accent-bright transition-colors mb-2">Flat Belt Conveyors</h3>
            <p class="text-base text-white/60">Where most flat belting runs</p>
          </a>
          <a href="/conveyor-types/modular-conveyors/" class="group p-7 border border-white/10 bg-white/[0.03] hover:bg-white/[0.06] hover:border-accent/40 transition-all">
            <h3 class="font-display text-xl font-bold uppercase tracking-wider text-white group-hover:text-accent-bright transition-colors mb-2">Modular Belt Conveyors</h3>
            <p class="text-base text-white/60">Interlocking plastic belt systems</p>
          </a>
          <a href="/resources/conveyor-maintenance/" class="group p-7 border border-white/10 bg-white/[0.03] hover:bg-white/[0.06] hover:border-accent/40 transition-all">
            <h3 class="font-display text-xl font-bold uppercase tracking-wider text-white group-hover:text-accent-bright transition-colors mb-2">Maintenance Guide</h3>
            <p class="text-base text-white/60">PM schedules and troubleshooting</p>
          </a>
        </div>
      </div>
    </section>
  </article>

  <!-- FAQ -->
  <section class="py-20 bg-surface-dim" aria-labelledby="faq-heading">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 id="faq-heading" class="font-display text-4xl sm:text-5xl font-extrabold text-ink tracking-wide uppercase mb-10">
        Frequently Asked <span class="text-accent">Questions</span>
      </h2>

      <div class="space-y-4">
        <details class="group border border-border bg-surface p-6 open:pb-8" open>
          <summary class="font-display text-xl font-bold uppercase tracking-wider text-ink cursor-pointer list-none flex items-center justify-between group-open:mb-4">
            What are the main types of conveyor belt material?
            <svg class="w-6 h-6 text-ink-muted group-open:rotate-180 transition-transform flex-shrink-0 ml-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
          </summary>
          <div class="text-ink-muted leading-relaxed space-y-3">
            <p>Six main types: PVC (general-purpose, lowest cost), polyurethane (food-grade, abrasion resistant), silicone (high heat, non-stick), rubber (heavy-duty grip and impact), modular plastic (repairable, sprocket-driven), and metal (ovens, freezers, heavy loads). Selection depends on product contact, temperature, chemicals, incline, uptime, and budget.</p>
          </div>
        </details>

        <details class="group border border-border bg-surface p-6 open:pb-8">
          <summary class="font-display text-xl font-bold uppercase tracking-wider text-ink cursor-pointer list-none flex items-center justify-between group-open:mb-4">
            What belt material is FDA-approved for food?
            <svg class="w-6 h-6 text-ink-muted group-open:rotate-180 transition-transform flex-shrink-0 ml-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
          </summary>
          <div class="text-ink-muted leading-relaxed space-y-3">
            <p>Polyurethane, silicone, some PVC formulations, acetal and polypropylene modular plastics, and stainless steel are available in formulations that comply with FDA 21 CFR Part 177. Polyurethane is widely specified because it combines compliance, abrasion resistance, and easy cleaning. USDA acceptance also depends on smooth, cleanable belt construction. Blue and white colors aid visual <a href="/conveyor-functions/inspection-detection/" class="text-accent hover:text-accent-hover font-semibold">contamination detection</a>.</p>
          </div>
        </details>

        <details class="group border border-border bg-surface p-6 open:pb-8">
          <summary class="font-display text-xl font-bold uppercase tracking-wider text-ink cursor-pointer list-none flex items-center justify-between group-open:mb-4">
            Which belt material is most abrasion resistant?
            <svg class="w-6 h-6 text-ink-muted group-open:rotate-180 transition-transform flex-shrink-0 ml-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
          </summary>
          <div class="text-ink-muted leading-relaxed space-y-3">
            <p>Among polymer belts, rubber and polyurethane. In modular plastic belts, acetal is hard and wear resistant, abrasion-resistant nylon grades are offered for severe wear, and polypropylene trades some wear resistance for chemical resistance. Metal belts resist abrasion best but cost more. Ask suppliers for wear data on your product.</p>
          </div>
        </details>

        <details class="group border border-border bg-surface p-6 open:pb-8">
          <summary class="font-display text-xl font-bold uppercase tracking-wider text-ink cursor-pointer list-none flex items-center justify-between group-open:mb-4">
            How long does a conveyor belt last?
            <svg class="w-6 h-6 text-ink-muted group-open:rotate-180 transition-transform flex-shrink-0 ml-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
          </summary>
          <div class="text-ink-muted leading-relaxed space-y-3">
            <p>It depends on material, product abrasion, speed, tension, cleaning chemicals, temperature, and maintenance. Modular plastic belts often last longest in service because damaged modules are replaced individually. Tracking, tensioning, and cleaning matter as much as material, and a mistracking belt can be destroyed quickly. See the <a href="/resources/conveyor-maintenance/" class="text-accent hover:text-accent-hover font-semibold">maintenance guide</a> for procedures.</p>
          </div>
        </details>

        <details class="group border border-border bg-surface p-6 open:pb-8">
          <summary class="font-display text-xl font-bold uppercase tracking-wider text-ink cursor-pointer list-none flex items-center justify-between group-open:mb-4">
            What is a modular conveyor belt?
            <svg class="w-6 h-6 text-ink-muted group-open:rotate-180 transition-transform flex-shrink-0 ml-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
          </summary>
          <div class="text-ink-muted leading-relaxed space-y-3">
            <p>Interlocking plastic modules joined by hinge rods. Damaged modules are replaced without removing the belt. Sprocket drive means no tracking problems. Food-grade acetal, polypropylene, and polyethylene are standard. Higher upfront cost than flat belts, with less repair time and downtime.</p>
          </div>
        </details>
      </div>
    </div>
  </section>

