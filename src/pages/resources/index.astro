---
import BaseLayout from '../../layouts/BaseLayout.astro';

const resources = [
  { name: 'Automated Conveyor Systems', slug: 'automated-conveyor-systems', desc: 'PLC integration, sensors, VFDs, Industry 4.0/IIoT, and warehouse vs. packaging line automation', status: 'live', icon: '⚙' },
  { name: 'Cost & Pricing Guide', slug: 'conveyor-cost-guide', desc: 'Cost factors by conveyor type, materials, controls, environment, and installation', status: 'live', icon: '$' },
  { name: 'Design & Sizing Guide', slug: 'conveyor-design-guide', desc: 'Speed calculations, throughput formulas, layout planning, and conveyor sizing reference', status: 'coming', icon: '📐' },
  { name: 'Manufacturer Directory', slug: 'conveyor-manufacturers', desc: 'Conveyor manufacturers and integrators filtered by type, industry, and capability', status: 'coming', icon: '🏭' },
  { name: 'Supplier Sourcing Guide', slug: 'conveyor-suppliers', desc: 'How to source conveyor systems and parts: OEM vs distributor, lead times, and RFQ best practices', status: 'live', icon: '📦' },
  { name: 'Maintenance Guide', slug: 'conveyor-maintenance', desc: 'Preventive maintenance schedules, belt tracking, roller replacement, and lubrication guides', status: 'coming', icon: '🔧' },
  { name: 'Conveyor Safety', slug: 'conveyor-safety', desc: 'OSHA requirements, guarding standards, E-stop placement, and lockout/tagout procedures', status: 'coming', icon: '⚠' },
  { name: 'Belt Selection Guide', slug: 'conveyor-belting', desc: 'Belt material comparison, PVC, polyurethane, silicone, modular plastic, wire mesh', status: 'live', icon: '▬' },
  { name: 'Conveyor Companies', slug: 'conveyor-companies', desc: 'Overview of major conveyor companies, integrators, and OEMs serving the packaging industry', status: 'live', icon: '🏢' },
  { name: 'Motors & Drives', slug: 'conveyor-motors-drives', desc: 'Conveyor motor types, VFDs, gear reducers, and drive selection for packaging conveyor applications', status: 'live', icon: '⚡' },
  { name: 'Parts & Components', slug: 'conveyor-parts', desc: 'Conveyor replacement parts, wear components, rollers, bearings, belts, and sourcing guide', status: 'live', icon: '🔩' },
  { name: 'Custom Conveyor Manufacturers', slug: 'conveyor-manufacturers/custom', desc: 'Custom conveyor manufacturers and fabricators that build to specification for unique applications', status: 'live', icon: '🛠' },
];

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://packagingconveyor.com/" },
    { "@type": "ListItem", "position": 2, "name": "Resources", "item": "https://packagingconveyor.com/resources/" }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What resources are available for specifying conveyor systems?",
      "acceptedAnswer": { "@type": "Answer", "text": "PackagingConveyor.com provides free technical resources including a conveyor cost and pricing guide, automated conveyor systems overview, design and sizing calculations, manufacturer directory, maintenance guides, safety references, belt selection guides, and a conveyor glossary. All resources are written for packaging engineers and plant managers." }
    },
    {
      "@type": "Question",
      "name": "How do I estimate conveyor system costs?",
      "acceptedAnswer": { "@type": "Answer", "text": "Conveyor costs depend on type (roller, belt, MDR, spiral), length, width, material (carbon steel, stainless, aluminum), motor/drive type, controls complexity, environment (standard, washdown, cleanroom), and installation requirements. Our cost guide breaks down each factor with relative cost comparisons. Contact manufacturers directly for project-specific quotes." }
    }
  ]
};
---
<BaseLayout
  title="Conveyor Resources: Guides, Tools & Technical References | PackagingConveyor.com"
  description="Free conveyor engineering resources: cost guides, automation overviews, design calculators, manufacturer directories, maintenance schedules, and belt selection guides."
  canonical="https://packagingconveyor.com/resources/"
  schema={[breadcrumbSchema, faqSchema]}
>
<h1>Conveyor Resources: Guides, Tools &amp; Technical References</h1>
<p class="usa-intro">Engineering references for specifying, budgeting, and maintaining packaging conveyor systems. Every guide is free, technical, and written for packaging engineers, not marketing departments.</p>
<h2 id="resources-heading">Technical Guides</h2>
<ul class="usa-collection">{resources.map((r) => (
<li class="usa-collection__item"><div class="usa-collection__body"><h3 class="usa-collection__heading"><a class="usa-link" href={`/resources/${r.slug}/`}>{r.name}</a></h3><p class="usa-collection__description">{r.desc}</p></div></li>
))}</ul>
<h2 id="quick-heading">Most Visited Resources</h2>
<ul class="usa-collection">
<li class="usa-collection__item"><div class="usa-collection__body"><h3 class="usa-collection__heading"><a class="usa-link" href="/resources/conveyor-cost-guide/">Cost &amp; Pricing Guide</a></h3><p class="usa-collection__description">Understand what drives conveyor pricing, type, materials, controls, environment, and installation</p></div></li>
<li class="usa-collection__item"><div class="usa-collection__body"><h3 class="usa-collection__heading"><a class="usa-link" href="/resources/automated-conveyor-systems/">Automated Conveyor Systems</a></h3><p class="usa-collection__description">PLC integration, sensor types, VFDs, IIoT, and automation architecture for packaging lines</p></div></li>
<li class="usa-collection__item"><div class="usa-collection__body"><h3 class="usa-collection__heading"><a class="usa-link" href="/conveyor-types/">All Conveyor Types</a></h3><p class="usa-collection__description">30+ conveyor types with specs, comparisons, and selection criteria</p></div></li>
<li class="usa-collection__item"><div class="usa-collection__body"><h3 class="usa-collection__heading"><a class="usa-link" href="/conveyor-functions/">Conveyor Functions</a></h3><p class="usa-collection__description">Accumulate, index, reject, lane, load trays, start with what your conveyor needs to do</p></div></li>
</ul>
<h2 id="explore-heading">Other Ways to Browse</h2>
<ul class="usa-collection">
<li class="usa-collection__item">
<div class="usa-collection__body">
<h3 class="usa-collection__heading"><a class="usa-link" href="/conveyor-types/">By Conveyor Type</a></h3>
<p class="usa-collection__description">30+ types, roller, belt, MDR, spiral, tabletop, chain, and more.</p></div></li>
<li class="usa-collection__item">
<div class="usa-collection__body">
<h3 class="usa-collection__heading"><a class="usa-link" href="/industries/">By Industry</a></h3>
<p class="usa-collection__description">Food, pharmaceutical, automotive, and warehouse applications.</p></div></li>
<li class="usa-collection__item">
<div class="usa-collection__body">
<h3 class="usa-collection__heading"><a class="usa-link" href="/conveyor-functions/">By Function</a></h3>
<p class="usa-collection__description">Accumulate, index, reject, lane, load trays, task-based selection.</p></div></li>
</ul>
<h2 id="faq-heading">Frequently Asked Questions</h2>
<div class="usa-accordion usa-accordion--bordered usa-accordion--multiselectable" data-allow-multiple="">
<h3 class="usa-accordion__heading"><button type="button" class="usa-accordion__button" aria-expanded="true" aria-controls="faq-1">What resources are available for specifying conveyor systems?</button></h3>
<div id="faq-1" class="usa-accordion__content usa-prose">
<p>This site provides free technical resources including a <a href="/resources/conveyor-cost-guide/">cost and pricing guide</a>, <a href="/resources/automated-conveyor-systems/">automated conveyor systems overview</a>, design and sizing calculations, manufacturer directory, maintenance guides, safety references, and belt selection guides. All resources target packaging engineers and plant managers rather than general audiences.</p>

</div>
<h3 class="usa-accordion__heading"><button type="button" class="usa-accordion__button" aria-expanded="false" aria-controls="faq-2">How do I estimate conveyor system costs?</button></h3>
<div id="faq-2" class="usa-accordion__content usa-prose">
<p>Conveyor costs depend on type (roller, belt, MDR, spiral), length, width, material (carbon steel vs. stainless vs. aluminum), motor/drive type, controls complexity, environment (standard vs. washdown vs. cleanroom), and installation requirements. The <a href="/resources/conveyor-cost-guide/">cost guide</a> breaks down each factor with relative cost comparisons using a $ to $$$$ scale. Contact manufacturers directly for project-specific quotes.</p>

</div>
</div>
</BaseLayout>
