<BaseLayout title="Conveyor Manufacturers &#x26; Supplier Directory | PackagingConveyor.com" description="Conveyor manufacturers organized by type, industry, and capability: belt, roller, modular plastic, sanitary, and specialty conveyor builders." canonical="https://packagingconveyor.com/resources/conveyor-manufacturers/" schema={[breadcrumbSchema, articleSchema, faqSchema, directorySchema]}>

<h1>Conveyor Manufacturer Directory</h1>
<p class="usa-intro">{manufacturers.length} manufacturers and integrators organized by conveyor type. Independent listings, no commissions. <a href="/resources/conveyor-companies/">Find companies near you</a>.</p>
<form class="dir-filters" role="search" aria-label="Filter manufacturers" onsubmit="return false">
  <div class="usa-form-group">
    <label class="usa-label" for="dir-search">Search by name, specialty, or location</label>
    <input class="usa-input" id="dir-search" name="dir-search" type="search" autocomplete="off" />
  </div>
  <div class="usa-form-group">
    <label class="usa-label" for="dir-category">Category</label>
    <select class="usa-select" id="dir-category" name="dir-category">
      <option value="">All categories</option>
      {allCategories.map(c => <option value={c}>{c}</option>)}
    </select>
  </div>
  <div class="usa-form-group">
    <label class="usa-label" for="dir-type">Company type</label>
    <select class="usa-select" id="dir-type" name="dir-type">
      <option value="">All types</option>
      {allTypes.map(t => <option value={t}>{t}</option>)}
    </select>
  </div>
</form>
<div class="dir-toolbar">
  <p id="dir-count" aria-live="polite">{manufacturers.length} companies</p>
  <ul class="usa-button-group usa-button-group--segmented" aria-label="Sort by">
    <li class="usa-button-group__item"><button type="button" class="usa-button dir-sort" data-sort="name" aria-pressed="true">Name</button></li>
    <li class="usa-button-group__item"><button type="button" class="usa-button usa-button--outline dir-sort" data-sort="hq" aria-pressed="false">Location</button></li>
    <li class="usa-button-group__item"><button type="button" class="usa-button usa-button--outline dir-sort" data-sort="type" aria-pressed="false">Type</button></li>
  </ul>
</div>
<div class="table-scroll" role="region" tabindex="0" aria-label="Manufacturer directory (table)">
  <table class="usa-table usa-table--compact stack-mobile" id="dir-table">
    <thead>
      <tr><th scope="col">Company</th><th scope="col">Known for</th><th scope="col">Category</th><th scope="col">Headquarters</th></tr>
    </thead>
    <tbody id="dir-tbody">
      {manufacturers.sort((a, b) => a.name.localeCompare(b.name)).map(m => (
        <tr class="dir-row" data-name={m.name.toLowerCase()} data-categories={JSON.stringify(m.categories)} data-type={m.type} data-hq={m.hq.toLowerCase()} data-known={m.knownFor.toLowerCase()} data-industries={m.industries.join(' ').toLowerCase()}>
          <td data-label="Company">
            {m.website ? <a href={m.website} target="_blank" rel="noopener noreferrer"><strong>{m.name}</strong></a> : <strong>{m.name}</strong>}
            <br /><span class="usa-tag">{m.type}</span>
          </td>
          <td data-label="Known for">{m.knownFor}</td>
          <td data-label="Category">{m.categories.join(', ')}</td>
