<script>
  const search = document.getElementById('dir-search') as HTMLInputElement | null;
  const catFilter = document.getElementById('dir-category') as HTMLSelectElement | null;
  const typeFilter = document.getElementById('dir-type') as HTMLSelectElement | null;
  const countEl = document.getElementById('dir-count');
  const emptyEl = document.getElementById('dir-empty');
  const resetBtn = document.getElementById('dir-reset');
  const tbody = document.getElementById('dir-tbody');
  const rows = Array.from(document.querySelectorAll<HTMLElement>('.dir-row'));
  const sortBtns = document.querySelectorAll<HTMLButtonElement>('.dir-sort');

  function applyFilters() {
    const q = (search?.value || '').toLowerCase().trim();
    const cat = catFilter?.value || '';
    const type = typeFilter?.value || '';
    let visible = 0;
    rows.forEach(row => {
      const d = row.dataset;
      const categories = JSON.parse(d.categories || '[]');
      const matchSearch = !q || [d.name, d.known, d.hq, d.industries].some(v => (v || '').includes(q));
      const show = matchSearch && (!cat || categories.includes(cat)) && (!type || d.type === type);
      row.hidden = !show;
      if (show) visible++;
    });
    if (countEl) countEl.textContent = `${visible} ${visible === 1 ? 'company' : 'companies'}`;
    if (emptyEl) emptyEl.hidden = visible !== 0;
  }

  function applySorting(field: string) {
    const key = (el: HTMLElement) => (field === 'hq' ? el.dataset.hq : field === 'type' ? el.dataset.type : el.dataset.name) || '';
    rows.sort((a, b) => key(a).localeCompare(key(b))).forEach(row => tbody?.appendChild(row));
  }

  search?.addEventListener('input', applyFilters);
  catFilter?.addEventListener('change', applyFilters);
  typeFilter?.addEventListener('change', applyFilters);
  sortBtns.forEach(btn => btn.addEventListener('click', () => {
    sortBtns.forEach(b => { b.classList.add('usa-button--outline'); b.setAttribute('aria-pressed', 'false'); });
    btn.classList.remove('usa-button--outline');
    btn.setAttribute('aria-pressed', 'true');
    applySorting(btn.dataset.sort || 'name');
  }));
  resetBtn?.addEventListener('click', () => {
    if (search) search.value = '';
    if (catFilter) catFilter.value = '';
    if (typeFilter) typeFilter.value = '';
    applyFilters();
  });
</script>
