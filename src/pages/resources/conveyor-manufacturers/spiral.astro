---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import MakerList from '../../../components/MakerList.astro';
import SpecChecklist from '../../../components/SpecChecklist.astro';

// Alphabetical. Every fact below comes from the company's own pages, checked October 5, 2026. See Sources.
const makers = [
  { name: 'Alliance Industrial Corporation', best: 'Custom geometry with installation', url: 'https://allianceindustrial.com/spiral-conveyors.html', type: 'Manufacturer', hq: 'Lynchburg, VA',
    builds: 'Case spirals built to incline or decline, with custom chain pitches, custom radii, and multiple infeed and discharge levels. Also single-file and narrow-track spirals, a 44-inch mini-spiral, and a sanitary side-drive spiral that runs Intralox chain for direct food contact. The company states that it designs, manufactures, and installs its spirals.',
    fit: 'the layout needs non-standard geometry, or you want one supplier to build and install.' },
  { name: 'AmbaFlex', best: 'Tall lifts and mixed pack sizes', url: 'https://www.ambaflex.com/en/products/spiralveyor-sv-series', type: 'Manufacturer', hq: 'Zwaag, Netherlands (US: Canton, OH)',
    builds: 'Separate spiral platforms by product size. SpiralVeyor SV carries cartons, containers, trays, bottle packs, bags, crates, and totes. SVm carries a mass flow of individual bottles and cans. SVs is a narrow-belt spiral for small primary packs, with up to 6 independent parallel belts. AccuVeyor AVh is a spiral-based accumulator. AmbaFlex lists SV elevation as commonly 15 m (50 ft) per drive system.',
    fit: 'one line needs spirals for both primary packs and cases, or the elevation change is tall.' },
  { name: 'Dorner', best: 'Light products and short lifts', url: 'https://www.dornerconveyors.com/products/flexmove/flexmove-helix', type: 'Manufacturer', hq: 'Hartland, WI', owner: 'Part of Columbus McKinnon since 2021',
    builds: 'FlexMove Helix flexible-chain spirals in 85, 180, and 260 mm widths. Published limits are 4 tiers, a 1,400 mm diameter at centerline, and a 3,450 mm maximum outfeed height. Incline is up to 7 degrees with flat top chain and up to 10 degrees with friction top chain.',
    fit: 'products are light, the elevation change is short, or the spiral is there to add buffering or cooling time between machines.' },
  { name: 'FlexLink', best: 'Smallest published footprint', url: 'https://www.flexlink.com/en/portfolio/conveyor-systems/spiral-conveyors', type: 'Manufacturer', hq: 'Gothenburg, Sweden', owner: 'Part of Coesia since 2012',
    builds: 'Spiral elevators with a plastic top chain on a steel chain base. The Compact Spiral elevator uses 85 mm chain, measures 585 mm in diameter, and raises or lowers products up to 2,900 mm. FlexLink lists parcels, totes, shrink-wrapped bottle packs, and cartons as spiral elevator applications.',
    fit: 'floor space is the main constraint and the products are small, or the line already runs FlexLink chain conveyors.' },
  { name: 'Multi-Conveyor', best: 'Custom accumulation spirals', url: 'https://www.multi-conveyor.com/packaging-solutions/spiral-drum-conveyors', type: 'Manufacturer', hq: 'Winneconne, WI', owner: 'Family-owned',
    builds: 'Designed-to-order drum spirals with a center drum drive. The unit runs one continuous belt with no intermediate dead plates, loads from the top or bottom, and can be placed in series with other spirals. Multi-Conveyor states that its engineers decide whether its own design or a partner OEM system fits the project.',
    fit: 'the goal is accumulation time in a small footprint as part of a custom packaging line. Ask which spirals are built in-house.' },
  { name: 'Nercon', best: 'Consumer packaged goods, dry or washdown', url: 'https://www.nerconconveyors.com/Conveyor/Conveyor-Equipment/Spiral-Conveyors', type: 'Manufacturer', hq: 'Neenah, WI',
    builds: 'Two designs. The table-top chain spiral runs up to 150 feet per minute, with belt widths from 3-1/4 to 15 inches and a 48 or 60 inch centerline footprint. Nercon lists pies, trays, small packages, boxes, and plastic containers as typical products. The washdown spiral is edge-driven and rated for washdown pressure up to 1,500 psi.',
    fit: 'the line carries consumer packaged goods and may need both a dry spiral and a washdown spiral.' },
  { name: 'Ryson International', best: 'Heavy cases, mass flow, and dual track', url: 'https://ryson.com/product/spiral-conveyor/', type: 'Manufacturer', hq: 'Yorktown, VA', owner: 'Owned by Royal Apollo Group',
    builds: 'Slat spirals pulled by a steel roller chain, which Ryson states need only a single drive. Models include Unit Load (case), Mass Flow, High Capacity, Narrow Trak, Dual Track, Multiple Infeed, and Wide Trak. Case spirals come in 12 to 26 inch slat widths and carry up to 1,800 lbs at one time. High Capacity spirals carry up to 3,600 lbs at speeds up to 200 FPM. Built and tested in Yorktown.',
    fit: 'you need a published load rating for cases or totes, a mass flow of bottles or cans, or two independent tracks in one structure.' },
  { name: 'Span Tech', best: 'Direct food contact and washdown', url: 'https://spantechconveyors.com/conveyors/incline-conveyors-conveyor-systems/spiral-conveyor/', type: 'Manufacturer', hq: 'Glasgow, KY',
    builds: 'Stainless steel spirals with washdown-capable modular plastic chain. The OutRunner design has no drum. A vertical drive shaft with a sprocket on each tier drives the chain along its outside edge. Spiral 2.0 is a simpler design for lighter-duty applications. Span Tech does not publish speed or load limits.',
    fit: 'the product touches the chain directly, the spiral gets washed down, or you want a drumless design.' },
];

const url = 'https://packagingconveyor.com/resources/conveyor-manufacturers/spiral/';
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://packagingconveyor.com/" },
    { "@type": "ListItem", "position": 2, "name": "Resources", "item": "https://packagingconveyor.com/resources/" },
    { "@type": "ListItem", "position": 3, "name": "Conveyor Manufacturers", "item": "https://packagingconveyor.com/resources/conveyor-manufacturers/" },
    { "@type": "ListItem", "position": 4, "name": "Spiral Conveyor Manufacturers", "item": url }
  ]
};

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "Best Spiral Conveyor Manufacturers: Top 8 Compared by Application",
  "description": "Eight spiral conveyor manufacturers compared by drive design, conveying surface, products carried, and published size and load limits.",
  "url": url,
  "datePublished": "2026-10-05",
  "author": { "@type": "Organization", "name": "PackagingConveyor.com", "url": "https://packagingconveyor.com" },
  "publisher": { "@type": "Organization", "name": "PackagingConveyor.com", "url": "https://packagingconveyor.com" }
};

const listSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Best spiral conveyor manufacturers by application",
  "description": "Top spiral conveyor manufacturers with the application each one fits best, listed alphabetically.",
  "numberOfItems": makers.length,
  "itemListElement": makers.map((m, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "item": { "@type": "Organization", "name": m.name, "url": m.url, "address": { "@type": "PostalAddress", "addressLocality": m.hq } }
  }))
