const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://packagingconveyor.com/" },
    { "@type": "ListItem", "position": 2, "name": "Conveyor Types", "item": "https://packagingconveyor.com/conveyor-types/" },
    { "@type": "ListItem", "position": 3, "name": "Pneumatic Conveying Systems", "item": "https://packagingconveyor.com/conveyor-types/pneumatic-conveyors/" }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is a pneumatic conveying system?",
      "acceptedAnswer": { "@type": "Answer", "text": "A pneumatic conveying system uses air pressure or vacuum to move dry bulk materials through a sealed pipeline. Powders, granules, pellets, and flakes either travel suspended in a fast airstream (dilute phase) or move as slow plugs or a dense bed (dense phase). The enclosed line contains dust, protects product from contamination, and routes around walls, floors, and equipment." }
    },
    {
      "@type": "Question",
      "name": "What is the difference between dilute phase and dense phase pneumatic conveying?",
      "acceptedAnswer": { "@type": "Answer", "text": "Dilute phase conveying keeps air velocity high enough that material stays suspended in the airstream, usually with a blower at low pressure. Dense phase conveying moves material as slow plugs or a dense bed at higher pressure, usually with compressed air and a pressure vessel. Dilute phase costs less to install and suits free-flowing, non-fragile materials. Dense phase suits fragile, abrasive, or blended materials because low velocity reduces particle breakage, segregation, and pipe wear." }
    },
    {
      "@type": "Question",
      "name": "Does a pneumatic conveying system need an air compressor?",
      "acceptedAnswer": { "@type": "Answer", "text": "Not always. Dilute phase pressure systems normally use a positive displacement blower, and vacuum systems use a vacuum pump or exhauster. Dense phase pressure systems need compressed air, from either a dedicated compressor or the plant air network. Air for hygroscopic, food, or pharmaceutical materials usually needs drying and oil-free supply or filtration. Size the air supply from conveying rate, route, and material test results, and confirm plant air can meet peak demand without starving other equipment." }
    },
    {
      "@type": "Question",
      "name": "What materials can be pneumatically conveyed?",
      "acceptedAnswer": { "@type": "Answer", "text": "Pneumatic conveyors handle most dry bulk solids: powders (flour, cement, starch, pigments), granules (sugar, salt, coffee), pellets (plastic resin, pet food, animal feed), flakes (cereal, dried herbs), and fibers (wood dust, textile waste). Materials that are very wet, sticky, or strongly hygroscopic may not convey pneumatically without special design, and some are better suited to mechanical conveyors." }
    },
    {
      "@type": "Question",
      "name": "Pneumatic conveyor vs. mechanical conveyor: which is better?",
      "acceptedAnswer": { "@type": "Answer", "text": "Pneumatic conveyors excel at enclosed, dust-free transport, complex routing through walls and floors, multiple pickup or delivery points, and contamination-sensitive or hazardous materials. Mechanical conveyors (belt, screw, drag chain) use substantially less energy per ton and usually cost less for short, straight, high-capacity runs. Choose pneumatic when containment or routing matters more than energy cost." }
    }
  ]
};

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "Pneumatic Conveying Systems: Dilute vs Dense Phase Guide",
  "description": "How pneumatic conveying systems work: dilute vs dense phase, vacuum vs pressure, blower vs compressor air supply, components, and a supplier spec checklist.",
  "url": "https://packagingconveyor.com/conveyor-types/pneumatic-conveyors/",
