---
import '../styles/theme.scss';
import '../styles/site.css';
import SideNav from '../components/SideNav.astro';
import { sections, sectionFor } from '../nav';
import { enhance } from '../lib/enhance';
import { lastModified } from '../lib/lastmod.mjs';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  schema?: object[];
  robots?: string;
  ogImage?: string;
}

const { title, description = "The packaging industry's most comprehensive conveyor resource. Technical guides, selection criteria, and encyclopedic coverage of 30+ conveyor types.", canonical, schema = [], robots = "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1", ogImage } = Astro.props;
const siteUrl = 'https://packagingconveyor.com';
// Used when a page has no photo of its own (legal and utility pages).
const defaultPhoto = { name: 'buffer-hartness-dynac-6400', alt: '' };
const currentPath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : Astro.url.pathname + '/';
const pageUrl = canonical || `${siteUrl}${currentPath}`;

// Default org + website schema on every page
const defaultSchema = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "PackagingConveyor.com",
    "url": siteUrl,
    "description": "Technical guides and selection criteria for 30+ packaging conveyor types across food, pharmaceutical, automotive, and warehouse applications.",
    "areaServed": "US"
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "PackagingConveyor.com",
    "url": siteUrl,
    "description": description
  }
];

const utility = ['/', '/about/', '/privacy/', '/terms/', '/thank-you/'].includes(currentPath);
const updated = utility ? undefined : lastModified(currentPath);
const updatedLabel = updated && new Date(`${updated}T12:00:00Z`).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const active = sectionFor(currentPath);

// Breadcrumb trail comes from the page's BreadcrumbList schema.
const crumbSchema = schema.find((s: any) => s['@type'] === 'BreadcrumbList') as any;
const crumbs: { name: string; href: string }[] = (crumbSchema?.itemListElement ?? []).map((i: any) => ({ name: i.name, href: new URL(i.item, siteUrl).pathname }));
const current = crumbs.pop();

const body = enhance(await Astro.slots.render('default'));
// Social and search image: the page's first photo, not a text banner. Video thumbnails are the second choice, the site photo is the last.
// The og-images integration in astro.config.mjs writes /img/og/<name>.jpg (1200 x 630) from the photo at build.
const photoTags = [...body.matchAll(/<img [^>]*src="\/img\/photos\/([\w-]+)\.webp"[^>]*>/g)].map(m => ({ name: m[1], alt: m[0].match(/alt="([^"]*)"/)?.[1] ?? '' }));
const lead = photoTags.find(p => !p.name.startsWith('yt-')) ?? photoTags[0] ?? defaultPhoto;
const pageOgImage = ogImage || `${siteUrl}/img/og/${lead.name}.jpg`;
const pageOgAlt = ogImage ? '' : lead.alt;
// Article and WebPage schema get the same image, and Article gets the real edit date the page shows.
const pageSchema = schema.map((s: any) => ['Article', 'WebPage'].includes(s['@type']) ? { ...s, image: s.image ?? [pageOgImage, ...(ogImage ? [] : [`${siteUrl}/img/photos/${lead.name}.webp`])], ...(s['@type'] === 'Article' && updated ? { dateModified: updated } : {}) } : s);
const allSchema = [...defaultSchema, ...pageSchema];
const toc = [...body.matchAll(/<h2[^>]*\sid="([^"]+)"[^>]*>([\s\S]*?)<\/h2>/g)].map(m => ({ slug: m[1], text: m[2].replace(/<[^>]+>/g, '').trim() }));
// Page header band (lbarsealer pattern): the page's H1 and intro move out of the content column into a full-width band.
const h1Match = body.match(/<h1[^>]*>([\s\S]*?)<\/h1>\s*(?:<p class="usa-intro">([\s\S]*?)<\/p>)?/);
const pageTitle = h1Match ? h1Match[1].trim() : title;
const intro = h1Match?.[2]?.trim();
// The first photo sits near the top of the page, so it loads eagerly. The rest stay lazy.
const content = (h1Match ? body.replace(h1Match[0], '') : body).replace(/(<img [^>]*src="\/img\/photos\/[^>]*?) loading="lazy"/, '$1 fetchpriority="high"');
const isHome = currentPath === '/';
const showToc = !isHome && toc.length >= 3;
// Homepage call-to-action buttons in the dark band.
const actions = isHome ? [{ label: 'Compare conveyor types', href: '/conveyor-types/' }, { label: 'Cost factors guide', href: '/resources/conveyor-cost-guide/' }] : [];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={pageUrl} />

  <!-- SEO: robots -->
  <meta name="robots" content={robots} />
  <link rel="preload" href="/fonts/source-sans-pro/sourcesanspro-regular-webfont.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/source-sans-pro/sourcesanspro-bold-webfont.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/merriweather/Latin-Merriweather-Bold.woff2" as="font" type="font/woff2" crossorigin />
  <meta name="theme-color" content="#b45309" />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={pageUrl} />
  <meta property="og:site_name" content="PackagingConveyor.com" />
  <meta property="og:locale" content="en_US" />
  <meta property="og:image" content={pageOgImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  {pageOgAlt && <meta property="og:image:alt" content={pageOgAlt} />}

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={pageOgImage} />
  {pageOgAlt && <meta name="twitter:image:alt" content={pageOgAlt} />}

  <script is:inline set:html={`(()=>{var n,e="usa-js-loading";function t(){document.documentElement.classList.remove(e)}document.documentElement.classList.add(e),n=setTimeout(t,8e3),window.addEventListener("load",function e(){window.uswdsPresent&&(clearTimeout(n),t(),window.removeEventListener("load",e,!0))},!0)})();`} />

  <!-- Structured Data -->
  {allSchema.map(s => (
    <script type="application/ld+json" set:html={JSON.stringify(s)} />
  ))}
</head>
<body>
  <a class="usa-skipnav" href="#main-content">Skip to main content</a>
  <div class="usa-overlay"></div>
  <header class="usa-header usa-header--basic">
    <div class="usa-nav-container">
      <div class="usa-navbar"><div class="usa-logo"><em class="usa-logo__text"><a href="/" title="PackagingConveyor.com home">Packaging<span class="logo-accent">Conveyor</span></a></em></div><button type="button" class="usa-menu-btn" aria-controls="primary-nav" aria-expanded="false">Menu</button></div>
      <nav aria-label="Primary navigation" class="usa-nav" id="primary-nav">
        <button type="button" class="usa-nav__close"><img src="/img/usa-icons/close.svg" alt="Close navigation" width="24" height="24" /></button>
        <ul class="usa-nav__primary usa-accordion">{sections.map(section => <li class="usa-nav__primary-item"><a href={section.href} class:list={['usa-nav__link', { 'usa-current': section === active }]} aria-current={currentPath === section.href ? 'page' : undefined}><span>{section.label}</span></a></li>)}</ul>
      </nav>
    </div>
  </header>
  <main id="main-content" tabindex="-1">
    <header class:list={['usa-section', 'page-header', isHome ? 'usa-section--dark page-header--home' : 'usa-section--light']}>
      <div class="grid-container">
        <div class="page-header__text">
          {current && (
            <nav class="usa-breadcrumb" aria-label="Breadcrumbs"><ol class="usa-breadcrumb__list">
              {crumbs.map(c => <li class="usa-breadcrumb__list-item"><a href={c.href} class="usa-breadcrumb__link"><span>{c.name}</span></a></li>)}
              <li class="usa-breadcrumb__list-item usa-current" aria-current="page"><span>{current.name}</span></li>
            </ol></nav>
          )}
          <h1 class="page-header__title" set:html={pageTitle} />
          {intro && <p class="usa-intro" set:html={intro} />}
          {updatedLabel && <p class="article-meta">Updated <time datetime={updated}>{updatedLabel}</time>. <a href="/about/#editorial-heading">How we research</a>.</p>}
          {actions.length > 0 && (
            <ul class="usa-button-group page-header__actions">{actions.map((a, i) => <li class="usa-button-group__item"><a class:list={['usa-button usa-button--big', { 'usa-button--outline usa-button--inverse': i > 0 }]} href={a.href}>{a.label}</a></li>)}</ul>
          )}
        </div>
      </div>
    </header>
    <div class="grid-container docs-layout">
      <div class="usa-in-page-nav-container docs-body">
        {showToc && <aside class="usa-in-page-nav" data-title-text="On this page" data-title-heading-level="p" data-heading-elements="h2" data-main-content-selector="#article" data-minimum-heading-count="3"></aside>}
        <div class="usa-prose docs-content" id="article">
          {showToc && (
            <nav class="page-toc" aria-label="Table of contents"><details><summary class="page-toc__title">On this page</summary><ul>{toc.map(h => <li><a href={`#${h.slug}`} set:html={h.text} /></li>)}</ul></details></nav>
          )}
          <Fragment set:html={content} />
        </div>
      </div>
      <SideNav />
    </div>
  </main>
  <footer class="usa-footer usa-footer--slim site-footer">
    <div class="usa-footer__primary-section">
      <div class="grid-container">
        <nav aria-label="Footer navigation"><ul class="footer-links">{sections.map(s => <li><a class="usa-footer__primary-link" href={s.href}>{s.label}</a></li>)}</ul></nav>
      </div>
    </div>
    <div class="grid-container footer-details">
      <p><strong>PackagingConveyor.com</strong></p>
      <p>Technical guides and selection criteria for packaging conveyor types.</p>
      <ul class="footer-links"><li><a href="/about/">About</a></li><li><a href="/privacy/">Privacy</a></li><li><a href="/terms/">Terms</a></li></ul>
      <p>&copy; {new Date().getFullYear()} PackagingConveyor.com. All rights reserved.</p>
    </div>
  </footer>
  <script>import '../scripts/site.ts';</script>
</body>
</html>
